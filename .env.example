# Copy to .env (gitignored). Nothing here is needed to run the default local setup.

# --- Optional cloud LLM benchmark mode (DEV ONLY, SYNTHETIC DATA ONLY) ---
# Cloud mode is OFF unless BOTH of these are set and llm.provider=cloud in config.
# VOICE_AGENT_ALLOW_CLOUD=1
# GEMINI_API_KEY=
# GEMINI_MODEL=   # check Google's docs for the current Flash-Lite-class name; not hard-coded

# --- Config overrides: VA__<section>__<key>=value (double underscore = nesting) ---
# VA__LLM__LOCAL__MODEL=qwen3:1.7b
# VA__LLM__LOCAL__NUM_THREAD=8
